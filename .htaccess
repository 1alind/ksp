# AURA Luxury Store - Apache Configuration
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /
    
    # Direct root to website/ if accessing via subdirectory structure
    RewriteCond %{REQUEST_URI} ^/$
    RewriteRule ^$ website/index.php [L]
</IfModule>

# Protect JSON database files from direct browser downloads
<FilesMatch "\.(json|lock)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order deny,allow
        Deny from all
    </IfModule>
</FilesMatch>

# Optimize character encoding
AddDefaultCharset UTF-8
